APP_NAME="Almira Tiket Event"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Operational timezone is still an open decision (see PRD section 15).
# Keep UTC until the business confirms the timezone used for order deadlines.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tiket_almira
DB_USERNAME=sail
DB_PASSWORD=

# Initial admin account used by database/seeders/AdminUserSeeder.php.
# Fill these in your local .env only; never commit real credentials.
ADMIN_NAME="Admin Almira"
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# E-ticket email delivery (config/tickets.php). Off by default: PRD FR-09 only
# sends the e-ticket when a mail service is configured, and the provider is
# still an open decision (PRD section 15 question 7). Turn on only after the
# MAIL_* values above point at a real service.
TICKET_EMAIL_ENABLED=false

# Object storage. Only needed where the local filesystem is not persistent,
# such as a serverless host. Leave empty for local development, which uses the
# `public` and `local` disks.
#
# AWS_BUCKET holds posters and is read publicly. AWS_PRIVATE_BUCKET holds
# payment proofs and must NOT allow public reads: proofs are personal data and
# are only ever streamed by Admin\PaymentProofController after authorisation.
# Two separate buckets are strongly preferred so that split is enforced by the
# bucket policy and not by application config alone.
#
# AWS_ENDPOINT and AWS_URL are for S3-compatible providers such as Cloudflare
# R2. With R2, AWS_DEFAULT_REGION=auto and AWS_URL must be the bucket's public
# development or custom domain, otherwise poster URLs will not resolve.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Disk selection. Defaults keep local development on the local filesystem.
# On a serverless host set POSTER_DISK=s3 and PAYMENT_PROOF_DISK=s3_private,
# otherwise every upload is written to a filesystem that is read-only or
# discarded, and the file is lost.
POSTER_DISK=public
PAYMENT_PROOF_DISK=local

# Shared secret for the HTTP cron endpoint that expires overdue orders
# (routes/web.php, config/cron.php). Empty means the endpoint returns 404,
# which is the correct default for local development where `schedule:work`
# runs the sweep instead.
#
# Required on any host with no always-on scheduler. Must be named CRON_SECRET
# on Vercel, which sends it automatically as a bearer token. Generate with
# `php artisan key:generate --show`.
CRON_SECRET=

# Escape hatch that allows the placeholder payment methods in
# config/payments.php to be shown outside local and testing. Off by default.
#
# Only for an internal deployment that real participants cannot reach: the
# account numbers are examples and money sent to them is lost. The page still
# shows the "Mode pengembangan" warning. Phase 05C removes the need for this.
PAYMENTS_ALLOW_DUMMY=false

VITE_APP_NAME="${APP_NAME}"
