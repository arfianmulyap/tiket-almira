{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "composer run vercel",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "memory": 512,
            "maxDuration": 60
        }
    },
    "routes": [
        { "src": "/index\\.php", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "crons": [
        {
            "path": "/cron/expire-overdue-orders",
            "schedule": "0 1 * * *"
        }
    ]
}
